{
  "root": true,
  "extends": ["react-app"],
  "settings": { "import/resolver": { "node": { "paths": ["src"], "extensions": [".js", ".jsx"] } } },
  "rules": {
    "no-undef": "error",
    "react/jsx-no-undef": "error",
    "import/named": "error",
    "import/no-unresolved": ["error", { "ignore": ["\\?inline$"] }],
    "no-unused-vars": "off"
  }
}
