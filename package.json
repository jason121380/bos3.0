{
  "name": "beautyos_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:build": "eslint --no-eslintrc -c scripts/eslint-build.json --max-warnings=0 --ext .js src",
    "test": "react-scripts test --verbose --runInBand --watchAll",
    "test:nowatch": "react-scripts test --verbose --runInBand --watchAll=false",
    "test:coverage": "react-scripts test --coverage --verbose --runInBand --watchAll=false",
    "lint": "npm run lint:build",
    "cy:open": "cypress open",
    "cy:run": "TZ=America/New_York cypress run --record"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@apollo/client": "3.4.17",
    "@floating-ui/react-dom": "^2.1.7",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@reduxjs/toolkit": "^1.9.5",
    "@sentry/react": "^6.0.2",
    "@sentry/tracing": "^6.0.2",
    "apollo-upload-client": "^17.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.0.4",
    "date-fns": "^2.9.0",
    "downshift": "8.5.0",
    "google-map-react": "^1.1.7",
    "graphql": "^15.3.0",
    "history": "^4.10.1",
    "idx": "^2.5.6",
    "immer": "^9.0.21",
    "lodash": "^4.17.20",
    "lucide-react": "^1.59.0",
    "md-editor-rt": "^2.2.1",
    "prismjs": "^1.17.1",
    "prop-types": "^15.7.2",
    "qrcode": "^1.4.4",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^11.0.5",
    "react-color": "^2.19.3",
    "react-copy-to-clipboard": "^5.1.0",
    "react-csv": "^2.2.2",
    "react-dom": "^17.0.2",
    "react-easy-crop": "^4.5.1",
    "react-google-recaptcha-enterprise": "^1.0.3",
    "react-helmet": "^5.2.1",
    "react-hook-form": "^6.14.0",
    "react-image-file-resizer": "^0.4.8",
    "react-markdown": "^8.0.3",
    "react-perfect-scrollbar": "^1.5.3",
    "react-redux": "^8.1.2",
    "react-router": "^5.1.2",
    "react-router-config": "^5.0.1",
    "react-router-dom": "^5.0.1",
    "recharts": "^2.1.16",
    "socket.io-client": "^4.6.0",
    "tailwind-merge": "^2.6.1",
    "validate.js": "^0.13.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-property-in-object": "^7.22.11",
    "@testing-library/dom": "^7.29.4",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.24",
    "cypress": "^6.0.1",
    "mutationobserver-shim": "^0.3.7",
    "react-scripts": "5.0.1",
    "sass": "^1.75.0",
    "sinon": "^7.4.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.21"
  },
  "jest": {
    "moduleNameMapper": {
      "^@radix-ui/primitive/is-development$": "<rootDir>/node_modules/@radix-ui/primitive/dist/internal/is-development.true.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!<rootDir>/node_modules/",
      "!<rootDir>/path/to/dir/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 7,
        "functions": 3,
        "lines": 5,
        "statements": 5
      },
      "./src/lib/api-base.js": {
        "lines": 90
      },
      "./src/lib/init-apollo.js": {
        "lines": 85
      },
      "./src/helper/billVerify.js": {
        "lines": 95
      },
      "./src/helper/helperDeduction.js": {
        "lines": 85
      },
      "./src/helper/truncateDecimal.js": {
        "lines": 100
      },
      "./src/helper/dailyUnlock.js": {
        "lines": 100
      }
    },
    "coverageReporters": [
      "text",
      "html"
    ]
  },
  "publishConfig": {
    "access": "restricted"
  }
}
