{
  "name": "beautyos_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "craco start",
    "build": "GENERATE_SOURCEMAP=false craco build",
    "test": "react-scripts test --verbose --runInBand --watchAll",
    "test:nowatch": "react-scripts test --verbose --runInBand --watchAll=false",
    "test:coverage": "react-scripts test --coverage --verbose --runInBand --watchAll=false",
    "eject": "react-scripts eject",
    "lint": "concurrently \"yarn lint:css\" \"yarn lint:js\"",
    "cy:open": "cypress open",
    "cy:run": "TZ=America/New_York cypress run --record --key c31e6e2f-2b58-4357-8b25-d2228915c61e"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
